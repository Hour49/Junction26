# Copy to backend/.env and fill in. Every key here is a field of app/settings.py (a test checks they match).
LOG_LEVEL=INFO
# The git commit this backend was started from, shown as GET /api/info `commit` (tools/qa-env.sh
# sets it). Empty: null
APP_COMMIT=
# Which adapter implements each pipeline port (app/composition.py). "hello" does nothing.
# ifc: a plan sheet with its IFC building model next to it (<model>.ifc and the sheet's SVG twin)
# is read through the model; a sheet without one stays on the vector route. Or hello
EXTRACTOR_BIM=ifc
EXTRACTOR_CAD=hello
# pdf: reads a drawn PDF sheet (and the PNG of the same sheet) from the PDF alone. Or hello
EXTRACTOR_VECTOR=pdf
# pdf: the vector route also reads the ruled schedules (door, window, finish...) printed on a
# drawn PDF sheet into `tables` (app/adapters/pdf_tables/). Or off
TABLES=pdf
# composite: a raster sheet (CubiCasa PNG) read by the components RASTER_COMPONENTS names, one
# source per part, e.g. elements=exp:detector/A,plans=one-plan,rooms=exp:ocr/A
# (exp:<track>/<arm> reads an arm's files in data/stoa/exp/, dir:<path> any extraction_v1 folder,
# detector:<arm>[:<tune run>] runs core's ONNX export in data/models/detector/<arm>/ on the CPU,
# detector-v4:<arm> / detector-v8:<arm> the same in 4 / 8 rotations and mirrors fused, with the
# folder's detector-v4.json / detector-v8.json thresholds (C-yolo26l: +1.0 pp on val, ~2.6 s a page),
# one-plan the whole page as one plan; app/adapters/raster/__init__.py). Or hello
EXTRACTOR_RASTER=hello
RASTER_COMPONENTS=
# The components for a camera photo of a plan (ingest's kind photo_plan, from EXIF or the Gemini
# kind signal), same format; photo:<arm> runs the ONNX export in data/models/photo/<arm>/. Empty:
# photos are read with RASTER_COMPONENTS like every other raster (app/adapters/raster/photo.py)
RASTER_PHOTO_COMPONENTS=
# off, or priors: a raster sheet that prints no scale gets an estimated one from its detected
# doors (a door leaf is 0.794 m; no door: no estimate), and each room its outline area at that
# scale; answers on it say "estimated" with the uncertainty (app/adapters/raster_scale/)
RASTER_SCALE=off
# off, or on: a sheet RASTER_SCALE=priors leaves without a scale because the detector found no door
# takes the estimate from the Carbon reader's door boxes (needs CARBON_READER=large); not fitted on
# Carbon's boxes yet (app/adapters/raster_scale/carbon_doors.py)
SCALE_CARBON_DOORS=off
# off, or carbon: a raster sheet's printed scale (a scale bar, or a printed ratio at a resolution
# the image states) replaces the scale estimated from its doors, which stays as a conflict value,
# and printed counts ("48 DORMS") are checked against the read ones, never replacing them
# (app/adapters/printed_scale/). carbon asks gemini-4-carbon with GEMINI_API_KEY under the spend
# guard, cached in CARBON_CACHE_DIR
RASTER_PRINTED_SCALE=off
# on (needs RASTER_PRINTED_SCALE=carbon): a count the sheet prints for exactly the subject and
# floor a count answers ("SECOND FLOOR = 48 DORMS" on a second-floor plan) is the answer; the count
# read off the drawing stays as the conflict's other value. off: both shown, no rule decides
PRINTED_TOTAL_ANSWERS=off
# on (with RASTER_PRINTED_SCALE=carbon): PP-OCR (local, CPU) reads again the digits Carbon read in
# the printed facts' boxes, and the scale text on a sheet of at most 40 MP; a value it reads
# differently gets a note (a count also a second value with OCR's reading) and a scale text it
# reads differently is not used (app/core/pipeline/printed_ocr.py). off: no second reading
PRINTED_OCR_CHECK=off
# on (with RASTER_PRINTED_SCALE=carbon): a printed gross floor area against the rooms found summed;
# a net/gross ratio outside 0.60-1.02 holds the indoor area answer for a person, both values shown
GROSS_NET_CHECK=off
# on (needs RASTER_PRINTED_SCALE=carbon): a raster sheet whose printed text is imperial (an imperial
# scale, feet-inch dimensions, SF or ft) gets its door estimate at a 0.914 m (3'-0") US leaf instead
# of the CubiCasa-fitted 0.794 m, and its rooms measured again (app/core/pipeline/door_prior.py)
DOOR_PRIOR_UNITS=off
# on (needs RASTER_SCALE=priors): a raster sheet whose counted doors are all Carbon's own boxes
# (none snapped onto a detector door: a snapped one has the detector's box) gets its estimate at
# Carbon's box width (1.069 m) instead of the detector's (0.794 m) (app/core/pipeline/door_prior.py)
DOOR_PRIOR_BOXES=off
# off, bar or on (with RASTER_PRINTED_SCALE). bar: a measured bar and the ratio printed beside it a
# known slip apart (4/3, sqrt 2, 3/2, 2, ARCH D on 11x17) keep the bar, with a note naming the cause
# and the ratio as a conflict value. on: also a ratio against the door estimate (no bar), decided by
# the rooms' printed areas, else every area is held (no better than chance against Carbon's doors,
# 2026-11-15) (app/core/pipeline/scale_signatures.py)
SCALE_SIGNATURES=off
# auto: the detector reads a page longer than 4000 px in 2048 px tiles (big sheets)
RASTER_TILES=off
# raster: a drawn PDF the vector reader has no sheet style for (a Revit or AutoCAD plot) is read
# on the raster route as the image of its page, flagged, never certified. off: it reads nothing
VECTOR_FALLBACK=off
# How the raster route types the rooms its rooms source read. furniture: the reader's types stand
# (a bed makes a bedroom). gold-labels: the printed label decides, as CubiCasa5K's answers do: a
# bedroom with no label is "other", ALK... a hall, a bathroom labelled WC a wc, APUK/APK/TUPAK...
# a kitchen. Only for a rooms source that reads labels (app/core/pipeline/room_policy.py)
ROOM_POLICY=furniture
# More readers of each raster sheet (EXTRACTOR_RASTER=composite), <name>=<source> pairs with the
# sources of RASTER_COMPONENTS, e.g. l1=detector:C-yolo26l,m1=detector:C-yolo26m. What each saw is
# kept with the drawing (double_check) and never counted: an answer that is not sure uses it to
# mark where the readers disagree with it (app/core/pipeline/disputed_marks.py). Empty: none
DOUBLE_CHECK_READERS=
# The Gemini room reader (raster route, only when RASTER_COMPONENTS names it): API key, model,
# seconds per page before it gives up (the rooms are then not read), reply cache folder
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_S=60
GEMINI_CACHE_DIR=../data/cache/gemini-rooms
# Gemini spend guard (app/core/spend.py): dollars all Gemini calls of this process may spend in
# total and in any hour (room reader, Decisions, sheet-kind signal, describer, answer
# confidence). Past either, Gemini steps answer as when Gemini fails and GET /api/info says
# gemini: budget_exhausted. Empty: no limit (e.g. GEMINI_BUDGET_USD=25, ..._PER_HOUR=5); 0: no
# Gemini call at all
GEMINI_BUDGET_USD=
GEMINI_BUDGET_USD_PER_HOUR=
# Gemini Decisions count distributions (app/adapters/decisions/, same key): the count swap is on
# when RASTER_COMPONENTS names decisions:<source> (e.g. elements=decisions:detector:<arm>); true
# here gives each count answer Gemini's probability. Seconds per request, reply cache folder
DECISIONS_CONFIDENCE=false
DECISIONS_TIMEOUT_S=30
DECISIONS_CACHE_DIR=../data/cache/decisions
# The sheet-kind signal at ingest (app/adapters/decisions_kind/): photo flag and P(floor plan)
DECISIONS_KIND=false
# The Carbon reader (app/adapters/carbon/): off, advanced (drawings the sheet-kind step calls
# advanced; needs SHEET_KIND=carbon), large (images over 4,000 px on their long side, from the
# file's header, and smaller raster pages where the shipped reader found fewer than 3 elements:
# Carbon counts the things drawn, the shipped reader the rooms) or all raster
# drawings, read by gemini-4-carbon alone
# and flagged (never certified); also the source `carbon` in RASTER_COMPONENTS and
# DOUBLE_CHECK_READERS. Same GEMINI_API_KEY and budget; seconds per call, reply cache
CARBON_READER=off
CARBON_TIMEOUT_S=120
CARBON_CACHE_DIR=../data/cache/carbon-reader
# Carbon calls in flight at once in the process, every reader's (several drawings are read at once)
CARBON_CALLS_IN_FLIGHT=8
# Carbon calls at once for one sheet's read (a big sheet's tiles), under CARBON_CALLS_IN_FLIGHT
CARBON_READ_WORKERS=4
# Local raster readings (the composite's detectors, arbiter and rooms) at once: each holds its page
# in memory, about 1.5-3 GB on a big sheet
INGEST_LOCAL_IN_FLIGHT=1
# The Carbon check of the levels: off, or demote (Carbon reads every raster drawing beside its
# reader, about 0.06 USD a page; a Medium answer it counts differently becomes Low, never counted),
# or ladder (the same, and a Medium answer it counts the same becomes High: two readers agree)
CARBON_LEVELS=off
# EU open models (app/adapters/openvlm/): our vLLM server on Verda behind an SSH tunnel; each
# Gemini step's provider is gemini or eu (no fallback between them)
EU_VLM_BASE_URL=http://127.0.0.1:18431/v1
EU_VLM_API_KEY=
EU_VLM_MODEL=Qwen/Qwen3.8-27B-FP8
EU_VLM_TIMEOUT_S=300
ROOMS_PROVIDER=gemini
DECISIONS_PROVIDER=gemini
KIND_PROVIDER=gemini
# The detector served on Verda (raster route, only when RASTER_COMPONENTS names `verda`): the
# endpoint's https URL, the Verda inference key, and how many pages are sent at once (4: more only
# queued at Verda's gateway)
VERDA_READER_URL=
VERDA_INFERENCE_API_KEY=
VERDA_READER_MAX_IN_FLIGHT=4
# The region arm (raster route, only when RASTER_COMPONENTS names `region:<detector arm>`): the
# annotated-flat segmenter's folder (empty: no region filter, the whole page counts)
REGION_MODEL_DIR=../data/models/region/R1-unet34
# The local count arbiter T1 (raster route, only when RASTER_COMPONENTS names
# `arbiter-t1:<detector arm>[:<one-view tune run>]`): arbiter.json, prior.json and the L1 model
ARBITER_MODEL_DIR=../data/models/arbiter/T1
# pdf: on a drawn PDF sheet, the scale bar against the scale text and each printed room area
# against the room's outline (ingest stage 8). ifc: those, and on a sheet read through its model
# what the model lists on the sheet's storey against what the sheet draws. Or hello: nothing is
# measured twice. A sheet without a model gets the same second readings from ifc as from pdf
SECOND_COUNTER=ifc
# hello, or templates: question text in any dataset language to a takeoff query, no model call
QUESTION_PARSER=templates
# none, or dev: a question the drawing gives no value for gets the dev split's best estimate, with
# abstain true (build data/stoa/priors/dev.json first: app/adapters/answer_prior.py says how)
ANSWER_PRIOR=dev
# true: an IFC model's fact sheet answers what the takeoff does not (app/core/answering/facts.py),
# never sure, confidence Low; IFC_FACTS_CACHE: a folder keeping each sheet as JSON ("" in memory)
IFC_FACTS=false
IFC_FACTS_CACHE=
# true: the agent chat takes a scale from its user for a drawing without one ("the scale is 1:100",
# "the kitchen is 12 m2"), kept in memory for that chat; areas on it are never sure
USER_SCALE=false
# off, template, glyphs or gemini: a scanned services/structural plan (triage names its discipline)
# read into a fact sheet at ingest. template: local readers (OCR legend, template symbols, mask
# runs), no model call; glyphs: the same with the trained glyph detector in
# DISCIPLINE_GLYPHS_MODEL (model.onnx, never committed) for the symbols; gemini: one Carbon call
# per page reads the legend and the symbols (GEMINI_API_KEY, spend guard). Its answers are Low,
# never sure. Sheets kept in the cache folder by the file's content (glyphs, gemini: a subfolder)
DISCIPLINE_PICTURES=off
DISCIPLINE_PICTURES_CACHE_DIR=../data/cache/discipline-pictures
DISCIPLINE_GLYPHS_MODEL=../data/models/pic-glyphs
# The picture lane's runs: mask (each coloured piece) or graph (a line graph per legend line style)
DISCIPLINE_RUNS=mask
# "" for none, or golden's data/stoa/exp/policy.json (answer_policy_v1, chosen on val): the
# families answered from the prior even when the drawing gives a value (app/adapters/answer_policy.py)
ANSWER_POLICY=
# "" for none, or golden's data/stoa/exp/gate.json (gate_policy_v1, chosen on val): an answer whose
# DECISIONS_CONFIDENCE probability is at or above its family's threshold gets sure: true
GATE_POLICY=
# "" for off, or golden's eval/results/gate/check-<config>.json (check_policy_v1, chosen on val by
# D455): an answer it does not certify keeps its value and asks a person to double-check it
CHECK_POLICY=
# off, or carbon: a model picks a value for a conflict no rule decides and checks an answer
# CHECK_POLICY does not certify (never a person's word; POST /api/projects/{id}/resolve, and on its
# own at the end of an ingest). carbon: gemini-4-carbon on GEMINI_API_KEY, inside GEMINI_BUDGET_USD,
# replies cached by request in RESOLVER_CACHE_DIR
RESOLVER=off
RESOLVER_MODEL=gemini-4-carbon
RESOLVER_TIMEOUT_S=30
RESOLVER_CACHE_DIR=../data/cache/resolver
# "" for none, or local-dec's local gate models, comma separated (local_gate_v1, e.g.
# ../data/models/arbiter/T1/lgate-rt-rooms-noL1-C1T1.json, the arm the policy was chosen on): a
# CHECK_POLICY family whose threshold is on one of their signals is certified on its score. A
# model reading L1 or the arbiter's P scores only drawings an arbiter-t1 ingest read, one reading
# readers only with its DOUBLE_CHECK_READERS; elsewhere its families ask. Read only with CHECK_POLICY set
LOCAL_GATES=
# Where uploaded projects, their drawing models and review edits are kept (gitignored)
PROJECTS_DIR=../data/projects
# Stored services models (decision 0017); `python -m app.cli services build --cache` writes them
SERVICES_CACHE_DIR=../data/cache/services
# The 3D view of IFC files (GET .../files/{file_id}/model.glb, FileStatus.model_3d); off: route 404,
# payloads unchanged. Each conversion runs alone (also across the app and the CLI) in a subprocess
# capped at this memory (1500: DigitalHub plumbing, the largest, peaks at 1.27 GB) and CPU seconds;
# precompute for a deploy, before the app starts: uv run python -m app.cli glb <project id or file.ifc>
MODEL_3D=false
MODEL_3D_MEMORY_MB=1500
MODEL_3D_TIMEOUT_S=120
# The synthetic sample archive POST /api/projects/sample ingests (scripts/make_sample_archive.py)
SAMPLE_ARCHIVE=../data/samples/sample-project.zip
# Where a drawing's licence credit is looked up by its content: the Stoa dataset (its
# data/<source>/LICENSE.md) and the Commons demo photos (manifest.jsonl). A missing folder: none
CREDIT_DATASET=../data/stoa/full/junction-dataset
CREDIT_PHOTOS=../data/stoa/exp/photo/real/commons
# none: an image is read as uploaded, turned upright by its EXIF orientation. A rectifier (the
# photo worker's) finds the paper in a phone photo and undoes the perspective before reading
RECTIFIER=none
# Drawing groups read at once at ingest: side by side is what makes a cold upload fast (6 cold
# images: 253 s at 1, 79 s at 4); 1 until the host's memory is checked (4 swapped past 10 GB)
INGEST_GROUPS_IN_FLIGHT=1
# The building-code rule packs, one JSON file per pack (docs/decisions/0009-building-code-checks.md).
# A pack with a rule that quotes no clause (ref, https URL, sentence) stops the start
RULE_PACKS_DIR=app/rules
# The building-law knowledge base, <pack>/<law id>.json (docs/decisions/0014-law-knowledge-base.md).
# A law file that does not validate stops the start, naming the file
LAWS_DIR=app/laws

# File triage (decision 0010): is each uploaded image a floor plan. off: as before triage.
# rules: the content probe's kind, no model. The describer and judge run only with a classifier.
TRIAGE_CLASSIFIER=off
# gemini: gemini-3.5-flash describes each non-plan (GEMINI_API_KEY), replies cached in the folder.
# carbon: gemini-4-carbon at thinking low, the same way (needs GEMINI_TIMEOUT_S >= 45)
TRIAGE_DESCRIBER=off
TRIAGE_DESCRIBER_CACHE_DIR=../data/cache/triage-describer
# rules: judge a described non-plan by its class alone, no model (the fallback of a model judge)
TRIAGE_JUDGE=off

# The project chat agent (decision 0013). CHAT_MODEL: gemini (needs GEMINI_API_KEY), rules (no
# key, deterministic) or off. Prices are USD per million tokens (placeholder until published)
CHAT_MODEL=rules
# on: every plan edit the chat proposes is followed through the project's service models
# (plumbing, ventilation, heating, electrical IFC files; decision 0016), and a project with an
# IFC file is offered the services tools (list, ask, move/add/remove/resize; decision 0017).
# off: neither
SERVICES_FOLLOW=off
AGENT_MODEL=gemini-4-hydrogen
AGENT_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AGENT_PRICE_IN_PER_M=1.50
AGENT_PRICE_OUT_PER_M=9.00
# prompt tokens read from Gemini's cache (usage.prompt_tokens_details.cached_tokens); Google lists
# 0.075/M: 0.375 is a deliberate overestimate for the spend guard
AGENT_PRICE_CACHED_PER_M=0.375
AGENT_TURN_USD=0.10
AGENT_MAX_STEPS=8
# reasoning_effort per model step: default (send none), none, low, medium or high (no minimal: 400)
AGENT_THINKING=low
# carbon: gemini-4-carbon says what each image is (GEMINI_API_KEY); a sheet with no floor plan and
# a non-plan kind at confidence >= the cut is set aside; a doubtful one is read, and with a non-plan
# kind flagged (answers Low, never certified). Replies cached in the folder. Works with
# TRIAGE_CLASSIFIER=off too
SHEET_KIND=off
SHEET_KIND_CACHE_DIR=../data/cache/sheet-kind
SHEET_KIND_CUT=0.9
# false: warn only, never set aside: the sheet is read, flagged with the kind it looks like (Low)
SHEET_KIND_SET_ASIDE=true
# Sheet.discipline: rules (title and sheet-number words, prompt sheet-kind-2) or gemini (the reply's own
# discipline field, prompt sheet-kind-3, unsure when the title names another; re-pays each cached reply once)
SHEET_DISCIPLINE=rules
# The evidence index's embedder (decision 0012): its model manifest; no file there (or empty): BM25 only
EVIDENCE_EMBEDDER_MANIFEST=../data/models/rag/manifest.json
# What the evidence index holds: set_aside (images triage set aside and described) or all_non_plan (every file and
# PDF page that is not a floor plan; pictures cost a sheet-kind and a describe call, GEMINI_API_KEY)
EVIDENCE_SCOPE=set_aside
