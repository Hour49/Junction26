# Copy to backend/.env and fill in. Every key here is a field of app/settings.py (a test checks they match).
LOG_LEVEL=INFO
# Which adapter implements each pipeline port (app/composition.py). "hello" does nothing.
# ifc: a plan sheet with its IFC building model next to it (<model>.ifc and the sheet's SVG twin)
# is read through the model; a sheet without one stays on the vector route. Or hello
EXTRACTOR_BIM=ifc
EXTRACTOR_CAD=hello
# pdf: reads a drawn PDF sheet (and the PNG of the same sheet) from the PDF alone. Or hello
EXTRACTOR_VECTOR=pdf
EXTRACTOR_RASTER=hello
# pdf: on a drawn PDF sheet, the scale bar against the scale text and each printed room area
# against the room's outline (ingest stage 8). ifc: those, and on a sheet read through its model
# what the model lists on the sheet's storey against what the sheet draws. Or hello: nothing is
# measured twice. A sheet without a model gets the same second readings from ifc as from pdf
SECOND_COUNTER=ifc
# hello, or templates: question text in any dataset language to a takeoff query, no model call
QUESTION_PARSER=templates
# none, or dev: a question the drawing gives no value for gets the dev split's best estimate, with
# abstain true (build data/stoa/priors/dev.json first: app/adapters/answer_prior.py says how)
ANSWER_PRIOR=dev
