# Copy to backend/.env and fill in. Every key here is a field of app/settings.py (a test checks they match).
LOG_LEVEL=INFO
# Which adapter implements each pipeline port (app/composition.py). "hello" does nothing.
EXTRACTOR_BIM=hello
EXTRACTOR_CAD=hello
# hello, or pdf: reads a drawn PDF sheet (and the PNG of the same sheet) from the PDF alone
EXTRACTOR_VECTOR=hello
EXTRACTOR_RASTER=hello
SECOND_COUNTER=hello
# hello, or templates: question text in any dataset language to a takeoff query, no model call
QUESTION_PARSER=templates
