# Copy to backend/.env and fill in. Every key here is a field of app/settings.py (a test checks they match).
LOG_LEVEL=INFO
# Which adapter implements each pipeline port (app/composition.py). "hello" does nothing.
# ifc: a plan sheet with its IFC building model next to it (<model>.ifc and the sheet's SVG twin)
# is read through the model; a sheet without one stays on the vector route. Or hello
EXTRACTOR_BIM=ifc
EXTRACTOR_CAD=hello
# pdf: reads a drawn PDF sheet (and the PNG of the same sheet) from the PDF alone. Or hello
EXTRACTOR_VECTOR=pdf
# pdf: the vector route also reads the ruled schedules (door, window, finish...) printed on a
# drawn PDF sheet into `tables` (app/adapters/pdf_tables/). Or off
TABLES=pdf
# composite: a raster sheet (CubiCasa PNG) read by the components RASTER_COMPONENTS names, one
# source per part, e.g. elements=exp:detector/A,plans=one-plan,rooms=exp:ocr/A
# (exp:<track>/<arm> reads an arm's files in data/stoa/exp/, dir:<path> any extraction_v1 folder,
# detector:<arm>[:<tune run>] runs core's ONNX export in data/models/detector/<arm>/ on the CPU,
# detector-v4:<arm> / detector-v8:<arm> the same in 4 / 8 rotations and mirrors fused, with the
# folder's detector-v4.json / detector-v8.json thresholds (C-yolo26l: +1.0 pp on val, ~2.6 s a page),
# one-plan the whole page as one plan; app/adapters/raster/__init__.py). Or hello
EXTRACTOR_RASTER=hello
RASTER_COMPONENTS=
# The components for a camera photo of a plan (ingest's kind photo_plan, from EXIF or the Gemini
# kind signal), same format; photo:<arm> runs the ONNX export in data/models/photo/<arm>/. Empty:
# photos are read with RASTER_COMPONENTS like every other raster (app/adapters/raster/photo.py)
RASTER_PHOTO_COMPONENTS=
# off, or priors: a raster sheet that prints no scale gets an estimated one from its detected
# doors (a door leaf is 0.794 m; no door: no estimate), and each room its outline area at that
# scale; answers on it say "estimated" with the uncertainty (app/adapters/raster_scale/)
RASTER_SCALE=off
# How the raster route types the rooms its rooms source read. furniture: the reader's types stand
# (a bed makes a bedroom). gold-labels: the printed label decides, as CubiCasa5K's answers do: a
# bedroom with no label is "other", ALK... a hall, a bathroom labelled WC a wc, APUK/APK/TUPAK...
# a kitchen. Only for a rooms source that reads labels (app/core/pipeline/room_policy.py)
ROOM_POLICY=furniture
# More readers of each raster sheet (EXTRACTOR_RASTER=composite), <name>=<source> pairs with the
# sources of RASTER_COMPONENTS, e.g. l1=detector:C-yolo26l,m1=detector:C-yolo26m. What each saw is
# kept with the drawing (double_check) and never counted: an answer that is not sure uses it to
# mark where the readers disagree with it (app/core/pipeline/disputed_marks.py). Empty: none
DOUBLE_CHECK_READERS=
# The Gemini room reader (raster route, only when RASTER_COMPONENTS names it): API key, model,
# seconds per page before it gives up (the rooms are then not read), reply cache folder
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_S=60
GEMINI_CACHE_DIR=../data/cache/gemini-rooms
# Gemini Decisions count distributions (app/adapters/decisions/, same key): the count swap is on
# when RASTER_COMPONENTS names decisions:<source> (e.g. elements=decisions:detector:<arm>); true
# here gives each count answer Gemini's probability. Seconds per request, reply cache folder
DECISIONS_CONFIDENCE=false
DECISIONS_TIMEOUT_S=30
DECISIONS_CACHE_DIR=../data/cache/decisions
# The sheet-kind signal at ingest (app/adapters/decisions_kind/): photo flag and P(floor plan)
DECISIONS_KIND=false
# EU open models (app/adapters/openvlm/): our vLLM server on Verda behind an SSH tunnel; each
# Gemini step's provider is gemini or eu (no fallback between them)
EU_VLM_BASE_URL=http://127.0.0.1:18431/v1
EU_VLM_API_KEY=
EU_VLM_MODEL=Qwen/Qwen3.8-27B-FP8
EU_VLM_TIMEOUT_S=300
ROOMS_PROVIDER=gemini
DECISIONS_PROVIDER=gemini
KIND_PROVIDER=gemini
# The detector served on Verda (raster route, only when RASTER_COMPONENTS names `verda`): the
# endpoint's https URL, the Verda inference key, and how many pages are sent at once (4: more only
# queued at Verda's gateway)
VERDA_READER_URL=
VERDA_INFERENCE_API_KEY=
VERDA_READER_MAX_IN_FLIGHT=4
# The region arm (raster route, only when RASTER_COMPONENTS names `region:<detector arm>`): the
# annotated-flat segmenter's folder (empty: no region filter, the whole page counts)
REGION_MODEL_DIR=../data/models/region/R1-unet34
# The local count arbiter T1 (raster route, only when RASTER_COMPONENTS names
# `arbiter-t1:<detector arm>[:<one-view tune run>]`): arbiter.json, prior.json and the L1 model
ARBITER_MODEL_DIR=../data/models/arbiter/T1
# pdf: on a drawn PDF sheet, the scale bar against the scale text and each printed room area
# against the room's outline (ingest stage 8). ifc: those, and on a sheet read through its model
# what the model lists on the sheet's storey against what the sheet draws. Or hello: nothing is
# measured twice. A sheet without a model gets the same second readings from ifc as from pdf
SECOND_COUNTER=ifc
# hello, or templates: question text in any dataset language to a takeoff query, no model call
QUESTION_PARSER=templates
# none, or dev: a question the drawing gives no value for gets the dev split's best estimate, with
# abstain true (build data/stoa/priors/dev.json first: app/adapters/answer_prior.py says how)
ANSWER_PRIOR=dev
# "" for none, or golden's data/stoa/exp/policy.json (answer_policy_v1, chosen on val): the
# families answered from the prior even when the drawing gives a value (app/adapters/answer_policy.py)
ANSWER_POLICY=
# "" for none, or golden's data/stoa/exp/gate.json (gate_policy_v1, chosen on val): an answer whose
# DECISIONS_CONFIDENCE probability is at or above its family's threshold gets sure: true
GATE_POLICY=
# "" for off, or golden's eval/results/gate/check-<config>.json (check_policy_v1, chosen on val by
# D455): an answer it does not certify keeps its value and asks a person to double-check it
CHECK_POLICY=
# "" for none, or local-dec's local gate models, comma separated (local_gate_v1, e.g.
# ../data/models/arbiter/T1/lgate-rt-rooms-noL1-C1T1.json, the arm the policy was chosen on): a
# CHECK_POLICY family whose threshold is on one of their signals is certified on its score. A
# model reading L1 or the arbiter's P scores only drawings an arbiter-t1 ingest read, one reading
# readers only with its DOUBLE_CHECK_READERS; elsewhere its families ask. Read only with CHECK_POLICY set
LOCAL_GATES=
# Where uploaded projects, their drawing models and review edits are kept (gitignored)
PROJECTS_DIR=../data/projects
# The synthetic sample archive POST /api/projects/sample ingests (scripts/make_sample_archive.py)
SAMPLE_ARCHIVE=../data/samples/sample-project.zip
# Where a drawing's licence credit is looked up by its content: the Stoa dataset (its
# data/<source>/LICENSE.md) and the Commons demo photos (manifest.jsonl). A missing folder: none
CREDIT_DATASET=../data/stoa/full/junction-dataset
CREDIT_PHOTOS=../data/stoa/exp/photo/real/commons
# none: an image is read as uploaded, turned upright by its EXIF orientation. A rectifier (the
# photo worker's) finds the paper in a phone photo and undoes the perspective before reading
RECTIFIER=none
# File triage (decision 0010): is each uploaded image a floor plan. off: as before triage.
# rules: the content probe's kind, no model. The describer and judge run only with a classifier.
TRIAGE_CLASSIFIER=off
TRIAGE_DESCRIBER=off
# rules: judge a described non-plan by its class alone, no model (the fallback of a model judge)
TRIAGE_JUDGE=off
