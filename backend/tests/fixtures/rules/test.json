      "title": "A bedroom or living room is at least 7 m2",
      "op": "room_area",
      "applies_to": {
        "room_types": [
          "bedroom",
          "living"
        ],
        "note": "test rooms"
      },
      "comparison": ">=",
      "limit": 7,
      "unit": "m2",
      "clause": {
        "ref": "Test 1 §1",
        "url": "https://example.org/test#1",
        "quote": "Testihuone on vähintään 7 m2.",
        "quote_en": "A test room is at least 7 m2."
      }
    },
    {
      "id": "test-bedroom-window",
      "title": "A bedroom has a window",
      "op": "room_windows",
      "applies_to": {
        "room_types": [
          "bedroom"
        ]
      },
      "comparison": ">=",
      "limit": 1,
      "unit": "count",
      "clause": {
        "ref": "Test 1 §2",
        "url": "https://example.org/test#2",
        "quote": "A test bedroom has a window."
      }
    },
    {
      "id": "test-door-width",
      "title": "A door opens at least 0.85 m clear",
      "op": "door_width",
      "comparison": ">=",
      "limit": 0.85,
      "unit": "m",
      "clause": {
        "ref": "Test 1 §3",
        "url": "https://example.org/test#3",
