      "key": "room:wc",
      "comparison": ">=",
      "limit": 1,
      "unit": "count",
      "clause": {
        "ref": "Test 1 §4",
        "url": "https://example.org/test#4",
        "quote": "A test dwelling has a WC."
      }
    }
