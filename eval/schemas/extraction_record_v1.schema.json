{
  "$defs": {
    "AreaEstimates": {
      "additionalProperties": false,
      "description": "Estimated gold room areas of one source against the predicted areas.",
      "properties": {
        "rooms": {
          "description": "matched rooms with an estimated gold area",
          "minimum": 0,
          "title": "Rooms",
          "type": "integer"
        },
        "missing": {
          "description": "of those, without a predicted area",
          "minimum": 0,
          "title": "Missing",
          "type": "integer"
        },
        "median_error": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Median Error"
        },
        "within_10": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Within 10"
        },
        "within_20": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Within 20"
        }
      },
      "required": [
        "rooms",
        "missing",
        "median_error",
        "within_10",
        "within_20"
      ],
      "title": "AreaEstimates",
      "type": "object"
    },
    "ConflictCounts": {
      "additionalProperties": false,
      "properties": {
        "found": {
          "$ref": "#/$defs/Ratio",
          "description": "gold conflict entries the prediction calls a conflict"
        },
        "agree": {
          "description": "gold agree entries",
          "minimum": 0,
          "title": "Agree",
          "type": "integer"
        },
        "false_alarms": {
          "description": "gold agree entries called a conflict",
          "minimum": 0,
          "title": "False Alarms",
          "type": "integer"
        },
        "unlisted": {
          "description": "predicted conflicts gold has no entry for",
          "minimum": 0,
          "title": "Unlisted",
          "type": "integer"
        }
      },
      "required": [
        "found",
        "agree",
        "false_alarms",
        "unlisted"
      ],
      "title": "ConflictCounts",
      "type": "object"
    },
    "ConflictsRecord": {
      "additionalProperties": false,
      "description": "Part 1 conflict slice (ingestion stage 8): recall and false alarms; not headline.",
      "properties": {
        "files": {
          "minimum": 0,
          "title": "Files",
          "type": "integer"
        },
        "overall": {
          "$ref": "#/$defs/ConflictCounts"
        },
        "by_quantity": {
          "additionalProperties": {
            "$ref": "#/$defs/ConflictCounts"
          },
          "title": "By Quantity",
          "type": "object"
        }
      },
      "required": [
        "files",
        "overall",
        "by_quantity"
      ],
      "title": "ConflictsRecord",
      "type": "object"
    },
    "Ratio": {
      "additionalProperties": false,
      "properties": {
        "n": {
          "minimum": 0,
          "title": "N",
          "type": "integer"
        },
        "correct": {
          "minimum": 0,
          "title": "Correct",
          "type": "integer"
        },
        "rate": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Rate"
        }
      },
      "required": [
        "n",
        "correct",
        "rate"
      ],
      "title": "Ratio",
      "type": "object"
    },
    "TablesRecord": {
      "additionalProperties": false,
      "description": "Part 1 schedules (truth tables, or tables next to elements); not headline.",
      "properties": {
        "files": {
          "minimum": 0,
          "title": "Files",
          "type": "integer"
        },
        "tables_found": {
          "$ref": "#/$defs/Ratio",
          "description": "gold tables matched by title or box IoU >= 0.3"
        },
        "tables_extra": {
          "description": "predicted tables matching no gold table",
          "minimum": 0,
          "title": "Tables Extra",
          "type": "integer"
        },
        "row_recall": {
          "$ref": "#/$defs/Ratio"
        },
        "row_precision": {
          "$ref": "#/$defs/Ratio",
          "description": "rows of found tables only"
        },
        "cell_accuracy": {
          "$ref": "#/$defs/Ratio",
          "description": "non-key cells of matched rows"
        }
      },
      "required": [
        "files",
        "tables_found",
        "tables_extra",
        "row_recall",
        "row_precision",
        "cell_accuracy"
      ],
      "title": "TablesRecord",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One recorded Part 1 run (extraction vs gold), a file in eval/results/runs/ next to the\nanswer runs; aggregates only (extraction_record_v1).",
  "properties": {
    "recorded_at": {
      "description": "from the clock, Europe/Helsinki",
      "format": "date-time",
      "title": "Recorded At",
      "type": "string"
    },
    "commit": {
      "description": "short git sha of the code that made the predictions: HEAD, or the clean export named with --commit",
      "pattern": "^[0-9a-f]{7,40}$",
      "title": "Commit",
      "type": "string"
    },
    "dirty": {
      "description": "that code had uncommitted changes (false for an export)",
      "title": "Dirty",
      "type": "boolean"
    },
    "committed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "when `commit` was made (committer time, Europe/Helsinki)",
      "title": "Committed At"
    },
    "eval_commit": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{7,40}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "the scorer's own HEAD, when `commit` names an export",
      "title": "Eval Commit"
    },
    "eval_dirty": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "the scorer had uncommitted changes; set with eval_commit",
      "title": "Eval Dirty"
    },
    "settings": {
      "anyOf": [
        {
          "patternProperties": {
            "^[a-z][a-z0-9_]{0,63}$": {
              "pattern": "^[A-Za-z0-9_.:+-]{1,64}$",
              "type": "string"
            }
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "the settings the run used (--setting), name lowercased",
      "title": "Settings"
    },
    "name": {
      "description": "the method's name",
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "note": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Note"
    },
    "part": {
      "const": "extraction",
      "description": "golden Part 1",
      "title": "Part",
      "type": "string"
    },
    "against": {
      "enum": [
        "golden",
        "dev",
        "eval"
      ],
      "title": "Against",
      "type": "string"
    },
    "golden_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "the golden set's version; golden runs only",
      "title": "Golden Version"
    },
    "milestone": {
      "title": "Milestone",
      "type": "boolean"
    },
    "gold_sha256": {
      "description": "sha256 over the gold files' names and contents",
      "title": "Gold Sha256",
      "type": "string"
    },
    "score_sha256": {
      "description": "sha256 of the full score JSON (gitignored runs folder)",
      "title": "Score Sha256",
      "type": "string"
    },
    "files": {
      "minimum": 0,
      "title": "Files",
      "type": "integer"
    },
    "predicted": {
      "minimum": 0,
      "title": "Predicted",
      "type": "integer"
    },
    "multiplicity": {
      "description": "counts weighed elements by attrs.multiplicity",
      "title": "Multiplicity",
      "type": "boolean"
    },
    "elements_f1": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Elements F1"
    },
    "elements_f1_by_source": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "null"
          }
        ]
      },
      "title": "Elements F1 By Source",
      "type": "object"
    },
    "room_f1": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Room F1"
    },
    "room_type_accuracy": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Room Type Accuracy"
    },
    "room_area_accuracy": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "description": "exact gold areas within 2%",
      "title": "Room Area Accuracy"
    },
    "room_area_estimates": {
      "additionalProperties": {
        "$ref": "#/$defs/AreaEstimates"
      },
      "description": "per source; estimated gold areas",
      "title": "Room Area Estimates",
      "type": "object"
    },
    "plans_exact": {
      "$ref": "#/$defs/Ratio"
    },
    "counts_exact": {
      "$ref": "#/$defs/Ratio"
    },
    "counts_exact_by_source": {
      "additionalProperties": {
        "$ref": "#/$defs/Ratio"
      },
      "title": "Counts Exact By Source",
      "type": "object"
    },
    "scale_status": {
      "$ref": "#/$defs/Ratio",
      "description": "scale cases whose predicted status is as expected"
    },
    "scale_status_by_source": {
      "additionalProperties": {
        "$ref": "#/$defs/Ratio"
      },
      "title": "Scale Status By Source",
      "type": "object"
    },
    "scale_m_per_unit": {
      "$ref": "#/$defs/Ratio",
      "description": "scaled gold cases predicted scaled within 2%"
    },
    "scale_m_per_unit_by_case": {
      "additionalProperties": {
        "$ref": "#/$defs/Ratio"
      },
      "title": "Scale M Per Unit By Case",
      "type": "object"
    },
    "scale_estimate_median_error": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "description": "estimates vs reference",
      "title": "Scale Estimate Median Error"
    },
    "scale_estimate_within_20": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Scale Estimate Within 20"
    },
    "tables": {
      "anyOf": [
        {
          "$ref": "#/$defs/TablesRecord"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "when the gold has tables"
    },
    "conflicts": {
      "anyOf": [
        {
          "$ref": "#/$defs/ConflictsRecord"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "when the gold has a conflict slice"
    }
  },
  "required": [
    "recorded_at",
    "commit",
    "dirty",
    "name",
    "note",
    "part",
    "against",
    "golden_version",
    "milestone",
    "gold_sha256",
    "score_sha256",
    "files",
    "predicted",
    "multiplicity",
    "elements_f1",
    "elements_f1_by_source",
    "room_f1",
    "room_type_accuracy",
    "room_area_accuracy",
    "plans_exact",
    "counts_exact",
    "counts_exact_by_source",
    "scale_status",
    "scale_m_per_unit",
    "scale_m_per_unit_by_case",
    "scale_estimate_median_error",
    "scale_estimate_within_20"
  ],
  "title": "ExtractionRecord_v1",
  "type": "object"
}
