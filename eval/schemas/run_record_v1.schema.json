{
  "$defs": {
    "AnswerV11Record": {
      "additionalProperties": false,
      "description": "answer_v1.1 on the golden questions: abstention and calibration (never headline).",
      "properties": {
        "answers": {
          "description": "golden questions with an answer line",
          "minimum": 0,
          "title": "Answers",
          "type": "integer"
        },
        "abstained": {
          "minimum": 0,
          "title": "Abstained",
          "type": "integer"
        },
        "abstain_rate": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Abstain Rate"
        },
        "not_abstained_accuracy": {
          "$ref": "#/$defs/Ratio"
        },
        "abstained_accuracy": {
          "$ref": "#/$defs/Ratio",
          "description": "the best estimate in `answer`, judged"
        },
        "with_confidence": {
          "minimum": 0,
          "title": "With Confidence",
          "type": "integer"
        },
        "calibration": {
          "items": {
            "$ref": "#/$defs/CalibrationBucket"
          },
          "title": "Calibration",
          "type": "array"
        }
      },
      "required": [
        "answers",
        "abstained",
        "abstain_rate",
        "not_abstained_accuracy",
        "abstained_accuracy",
        "with_confidence",
        "calibration"
      ],
      "title": "AnswerV11Record",
      "type": "object"
    },
    "CalibrationBucket": {
      "additionalProperties": false,
      "properties": {
        "low": {
          "title": "Low",
          "type": "number"
        },
        "high": {
          "title": "High",
          "type": "number"
        },
        "n": {
          "minimum": 0,
          "title": "N",
          "type": "integer"
        },
        "correct": {
          "minimum": 0,
          "title": "Correct",
          "type": "integer"
        },
        "accuracy": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Accuracy"
        },
        "mean_confidence": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Mean Confidence"
        }
      },
      "required": [
        "low",
        "high",
        "n",
        "correct",
        "accuracy",
        "mean_confidence"
      ],
      "title": "CalibrationBucket",
      "type": "object"
    },
    "EvidenceHitsGroup": {
      "additionalProperties": false,
      "properties": {
        "questions": {
          "minimum": 0,
          "title": "Questions",
          "type": "integer"
        },
        "with_boxes": {
          "description": "questions whose answer has an evidence box",
          "minimum": 0,
          "title": "With Boxes",
          "type": "integer"
        },
        "precision": {
          "$ref": "#/$defs/Ratio",
          "description": "boxes; correct = boxes that hit a gold target"
        },
        "recall": {
          "$ref": "#/$defs/Ratio",
          "description": "gold targets; correct = targets some box hits"
        }
      },
      "required": [
        "questions",
        "with_boxes",
        "precision",
        "recall"
      ],
      "title": "EvidenceHitsGroup",
      "type": "object"
    },
    "EvidenceHitsRecord": {
      "additionalProperties": false,
      "description": "Evidence hit rate on golden v2 (numeric questions on files with gold item boxes); not\nheadline.",
      "properties": {
        "rule": {
          "description": "the hit test, in words",
          "title": "Rule",
          "type": "string"
        },
        "overall": {
          "$ref": "#/$defs/EvidenceHitsGroup"
        },
        "by_source": {
          "additionalProperties": {
            "$ref": "#/$defs/EvidenceHitsGroup"
          },
          "title": "By Source",
          "type": "object"
        },
        "by_source_family": {
          "additionalProperties": {
            "$ref": "#/$defs/EvidenceHitsGroup"
          },
          "description": "source/what the question counts, e.g. swiss_dwellings/door",
          "title": "By Source Family",
          "type": "object"
        }
      },
      "required": [
        "rule",
        "overall",
        "by_source",
        "by_source_family"
      ],
      "title": "EvidenceHitsRecord",
      "type": "object"
    },
    "ExtrasRecord": {
      "additionalProperties": false,
      "description": "Part 2 extras, per kind (formats-v1-1 §3).",
      "properties": {
        "extras_sha256": {
          "title": "Extras Sha256",
          "type": "string"
        },
        "paraphrase": {
          "$ref": "#/$defs/Ratio",
          "description": "paraphrases answered right"
        },
        "paraphrase_origin": {
          "$ref": "#/$defs/Ratio",
          "description": "their origin questions answered right"
        },
        "paraphrase_gap": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "paraphrase minus origin accuracy",
          "title": "Paraphrase Gap"
        },
        "unanswerable_abstained": {
          "$ref": "#/$defs/Ratio",
          "description": "unanswerable lines with abstain: true"
        },
        "conflict_pass": {
          "$ref": "#/$defs/Ratio",
          "description": "both values in `conflicts` and the answer right"
        },
        "conflict_values_shown": {
          "$ref": "#/$defs/Ratio"
        },
        "conflict_answer_right": {
          "$ref": "#/$defs/Ratio"
        },
        "estimate_pass": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ratio"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "estimate lines within tolerance and with estimate: true; null in rows recorded before the estimate kind (2026-11-13)"
        },
        "estimate_value_right": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ratio"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "estimate_labelled": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ratio"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "extras_sha256",
        "paraphrase",
        "paraphrase_origin",
        "paraphrase_gap",
        "unanswerable_abstained",
        "conflict_pass",
        "conflict_values_shown",
        "conflict_answer_right"
      ],
      "title": "ExtrasRecord",
      "type": "object"
    },
    "Ratio": {
      "additionalProperties": false,
      "properties": {
        "n": {
          "minimum": 0,
          "title": "N",
          "type": "integer"
        },
        "correct": {
          "minimum": 0,
          "title": "Correct",
          "type": "integer"
        },
        "rate": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Rate"
        }
      },
      "required": [
        "n",
        "correct",
        "rate"
      ],
      "title": "Ratio",
      "type": "object"
    },
    "Stats": {
      "additionalProperties": false,
      "description": "Aggregate numbers for a group of questions.",
      "properties": {
        "n": {
          "minimum": 0,
          "title": "N",
          "type": "integer"
        },
        "correct": {
          "minimum": 0,
          "title": "Correct",
          "type": "integer"
        },
        "accuracy": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Accuracy"
        },
        "answered": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "all/dev/eval runs only",
          "title": "Answered"
        },
        "coverage": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "answered / n; all/dev/eval runs only",
          "title": "Coverage"
        }
      },
      "required": [
        "n",
        "correct",
        "accuracy",
        "answered",
        "coverage"
      ],
      "title": "Stats",
      "type": "object"
    },
    "TextClaimsRecord": {
      "additionalProperties": false,
      "description": "Free-text golden questions scored by curated claims (D52); not headline.",
      "properties": {
        "claims_sha256": {
          "title": "Claims Sha256",
          "type": "string"
        },
        "passed": {
          "$ref": "#/$defs/Ratio",
          "description": "text questions with claims; correct = every claim met"
        },
        "numbers": {
          "$ref": "#/$defs/Ratio",
          "description": "number claims matched one to one"
        },
        "names": {
          "$ref": "#/$defs/Ratio",
          "description": "name claims found"
        },
        "without_claims": {
          "description": "golden text questions with no claims line",
          "minimum": 0,
          "title": "Without Claims",
          "type": "integer"
        }
      },
      "required": [
        "claims_sha256",
        "passed",
        "numbers",
        "names",
        "without_claims"
      ],
      "title": "TextClaimsRecord",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One recorded score run, a file in eval/results/runs/ (run_record_v1). The repo is public, so\na row holds aggregates only: no question text, answers, templates or file names.",
  "properties": {
    "recorded_at": {
      "description": "from the clock, Europe/Helsinki",
      "format": "date-time",
      "title": "Recorded At",
      "type": "string"
    },
    "commit": {
      "description": "short git sha of the code that made the predictions: HEAD, or the clean export named with --commit",
      "pattern": "^[0-9a-f]{7,40}$",
      "title": "Commit",
      "type": "string"
    },
    "dirty": {
      "description": "that code had uncommitted changes (false for an export)",
      "title": "Dirty",
      "type": "boolean"
    },
    "committed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "when `commit` was made (committer time, Europe/Helsinki)",
      "title": "Committed At"
    },
    "eval_commit": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{7,40}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "the scorer's own HEAD, when `commit` names an export",
      "title": "Eval Commit"
    },
    "eval_dirty": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "the scorer had uncommitted changes; set with eval_commit",
      "title": "Eval Dirty"
    },
    "settings": {
      "anyOf": [
        {
          "patternProperties": {
            "^[a-z][a-z0-9_]{0,63}$": {
              "pattern": "^[A-Za-z0-9_.:+-]{1,64}$",
              "type": "string"
            }
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "the settings the run used (--setting), name lowercased",
      "title": "Settings"
    },
    "name": {
      "description": "the method's name",
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "note": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Note"
    },
    "against": {
      "enum": [
        "golden",
        "all",
        "dev",
        "eval"
      ],
      "title": "Against",
      "type": "string"
    },
    "golden_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "the golden set's version; golden runs only",
      "title": "Golden Version"
    },
    "milestone": {
      "title": "Milestone",
      "type": "boolean"
    },
    "part": {
      "const": "answering",
      "default": "answering",
      "description": "golden Part 2 (answers); rows before v2 have no field",
      "title": "Part",
      "type": "string"
    },
    "reads": {
      "anyOf": [
        {
          "enum": [
            "gold-extraction",
            "pipeline-extraction"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "what the answerer read as input; golden v2 runs only",
      "title": "Reads"
    },
    "questions_sha256": {
      "title": "Questions Sha256",
      "type": "string"
    },
    "score_sha256": {
      "description": "sha256 of the full score JSON (gitignored runs folder)",
      "title": "Score Sha256",
      "type": "string"
    },
    "overall": {
      "$ref": "#/$defs/Stats"
    },
    "numeric": {
      "$ref": "#/$defs/Stats"
    },
    "by_split": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/Stats"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "per split (golden: dev, holdout); rows before 2026-11-14 lack it",
      "title": "By Split"
    },
    "by_source_type": {
      "additionalProperties": {
        "$ref": "#/$defs/Stats"
      },
      "title": "By Source Type",
      "type": "object"
    },
    "evidence_coverage": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Evidence Coverage"
    },
    "cost_total_usd": {
      "title": "Cost Total Usd",
      "type": "number"
    },
    "cost_mean_usd": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Cost Mean Usd"
    },
    "latency_mean_s": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Latency Mean S"
    },
    "latency_p95_s": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Latency P95 S"
    },
    "extras": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExtrasRecord"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "the extras slice (golden v2 with extras.jsonl); not headline"
    },
    "answer_v1_1": {
      "anyOf": [
        {
          "$ref": "#/$defs/AnswerV11Record"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "abstain and calibration, when answers carry v1.1 fields"
    },
    "evidence_hits": {
      "anyOf": [
        {
          "$ref": "#/$defs/EvidenceHitsRecord"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "evidence precision and recall against Part 1 gold boxes"
    },
    "text_claims": {
      "anyOf": [
        {
          "$ref": "#/$defs/TextClaimsRecord"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "free-text questions scored by curated claims"
    }
  },
  "required": [
    "recorded_at",
    "commit",
    "dirty",
    "name",
    "note",
    "against",
    "golden_version",
    "milestone",
    "questions_sha256",
    "score_sha256",
    "overall",
    "numeric",
    "by_source_type",
    "evidence_coverage",
    "cost_total_usd",
    "cost_mean_usd",
    "latency_mean_s",
    "latency_p95_s"
  ],
  "title": "RunRecord_v1",
  "type": "object"
}
