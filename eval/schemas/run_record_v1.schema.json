{
  "$defs": {
    "AnswerV11Record": {
      "additionalProperties": false,
      "description": "answer_v1.1 on the golden questions: abstention and calibration (never headline).",
      "properties": {
        "answers": {
          "description": "golden questions with an answer line",
          "minimum": 0,
          "title": "Answers",
          "type": "integer"
        },
        "abstained": {
          "minimum": 0,
          "title": "Abstained",
          "type": "integer"
        },
        "abstain_rate": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Abstain Rate"
        },
        "not_abstained_accuracy": {
          "$ref": "#/$defs/Ratio"
        },
        "abstained_accuracy": {
          "$ref": "#/$defs/Ratio",
          "description": "the best estimate in `answer`, judged"
        },
        "with_confidence": {
          "minimum": 0,
          "title": "With Confidence",
          "type": "integer"
        },
        "calibration": {
          "items": {
            "$ref": "#/$defs/CalibrationBucket"
          },
          "title": "Calibration",
          "type": "array"
        }
      },
      "required": [
        "answers",
        "abstained",
        "abstain_rate",
        "not_abstained_accuracy",
        "abstained_accuracy",
        "with_confidence",
        "calibration"
      ],
      "title": "AnswerV11Record",
      "type": "object"
    },
    "CalibrationBucket": {
      "additionalProperties": false,
      "properties": {
        "low": {
          "title": "Low",
          "type": "number"
        },
        "high": {
          "title": "High",
          "type": "number"
        },
        "n": {
          "minimum": 0,
          "title": "N",
          "type": "integer"
        },
        "correct": {
          "minimum": 0,
          "title": "Correct",
          "type": "integer"
        },
        "accuracy": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Accuracy"
        },
        "mean_confidence": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Mean Confidence"
        }
      },
      "required": [
        "low",
        "high",
        "n",
        "correct",
        "accuracy",
        "mean_confidence"
      ],
      "title": "CalibrationBucket",
      "type": "object"
    },
    "ExtrasRecord": {
      "additionalProperties": false,
      "description": "Part 2 extras, per kind (formats-v1-1 §3).",
      "properties": {
        "extras_sha256": {
          "title": "Extras Sha256",
          "type": "string"
        },
        "paraphrase": {
          "$ref": "#/$defs/Ratio",
          "description": "paraphrases answered right"
        },
        "paraphrase_origin": {
          "$ref": "#/$defs/Ratio",
          "description": "their origin questions answered right"
        },
        "paraphrase_gap": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "paraphrase minus origin accuracy",
          "title": "Paraphrase Gap"
        },
        "unanswerable_abstained": {
          "$ref": "#/$defs/Ratio",
          "description": "unanswerable lines with abstain: true"
        },
        "conflict_pass": {
          "$ref": "#/$defs/Ratio",
          "description": "both values in `conflicts` and the answer right"
        },
        "conflict_values_shown": {
          "$ref": "#/$defs/Ratio"
        },
        "conflict_answer_right": {
          "$ref": "#/$defs/Ratio"
        }
      },
      "required": [
        "extras_sha256",
        "paraphrase",
        "paraphrase_origin",
        "paraphrase_gap",
        "unanswerable_abstained",
        "conflict_pass",
        "conflict_values_shown",
        "conflict_answer_right"
      ],
      "title": "ExtrasRecord",
      "type": "object"
    },
    "Ratio": {
      "additionalProperties": false,
      "properties": {
        "n": {
          "minimum": 0,
          "title": "N",
          "type": "integer"
        },
        "correct": {
          "minimum": 0,
          "title": "Correct",
          "type": "integer"
        },
        "rate": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Rate"
        }
      },
      "required": [
        "n",
        "correct",
        "rate"
      ],
      "title": "Ratio",
      "type": "object"
    },
    "Stats": {
      "additionalProperties": false,
      "description": "Aggregate numbers for a group of questions.",
      "properties": {
        "n": {
          "minimum": 0,
          "title": "N",
          "type": "integer"
        },
        "correct": {
          "minimum": 0,
          "title": "Correct",
          "type": "integer"
        },
        "accuracy": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Accuracy"
        },
        "answered": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "all/dev/eval runs only",
          "title": "Answered"
        },
        "coverage": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "answered / n; all/dev/eval runs only",
          "title": "Coverage"
        }
      },
      "required": [
        "n",
        "correct",
        "accuracy",
        "answered",
        "coverage"
      ],
      "title": "Stats",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One recorded score run, a file in eval/results/runs/ (run_record_v1). The repo is public, so\na row holds aggregates only: no question text, answers, templates or file names.",
  "properties": {
    "recorded_at": {
      "description": "from the clock, Europe/Helsinki",
      "format": "date-time",
      "title": "Recorded At",
      "type": "string"
    },
    "commit": {
      "description": "short git sha of HEAD",
      "pattern": "^[0-9a-f]{7,40}$",
      "title": "Commit",
      "type": "string"
    },
    "dirty": {
      "description": "tracked files had uncommitted changes",
      "title": "Dirty",
      "type": "boolean"
    },
    "name": {
      "description": "the method's name",
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "note": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Note"
    },
    "against": {
      "enum": [
        "golden",
        "all",
        "dev",
        "eval"
      ],
      "title": "Against",
      "type": "string"
    },
    "golden_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "the golden set's version; golden runs only",
      "title": "Golden Version"
    },
    "milestone": {
      "title": "Milestone",
      "type": "boolean"
    },
    "part": {
      "const": "answering",
      "default": "answering",
      "description": "golden Part 2 (answers); rows before v2 have no field",
      "title": "Part",
      "type": "string"
    },
    "reads": {
      "anyOf": [
        {
          "enum": [
            "gold-extraction",
            "pipeline-extraction"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "what the answerer read as input; golden v2 runs only",
      "title": "Reads"
    },
    "questions_sha256": {
      "title": "Questions Sha256",
      "type": "string"
    },
    "score_sha256": {
      "description": "sha256 of the full score JSON (gitignored runs folder)",
      "title": "Score Sha256",
      "type": "string"
    },
    "overall": {
      "$ref": "#/$defs/Stats"
    },
    "numeric": {
      "$ref": "#/$defs/Stats"
    },
    "by_source_type": {
      "additionalProperties": {
        "$ref": "#/$defs/Stats"
      },
      "title": "By Source Type",
      "type": "object"
    },
    "evidence_coverage": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Evidence Coverage"
    },
    "cost_total_usd": {
      "title": "Cost Total Usd",
      "type": "number"
    },
    "cost_mean_usd": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Cost Mean Usd"
    },
    "latency_mean_s": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Latency Mean S"
    },
    "latency_p95_s": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Latency P95 S"
    },
    "extras": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExtrasRecord"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "the extras slice (golden v2 with extras.jsonl); not headline"
    },
    "answer_v1_1": {
      "anyOf": [
        {
          "$ref": "#/$defs/AnswerV11Record"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "abstain and calibration, when answers carry v1.1 fields"
    }
  },
  "required": [
    "recorded_at",
    "commit",
    "dirty",
    "name",
    "note",
    "against",
    "golden_version",
    "milestone",
    "questions_sha256",
    "score_sha256",
    "overall",
    "numeric",
    "by_source_type",
    "evidence_coverage",
    "cost_total_usd",
    "cost_mean_usd",
    "latency_mean_s",
    "latency_p95_s"
  ],
  "title": "RunRecord_v1",
  "type": "object"
}
