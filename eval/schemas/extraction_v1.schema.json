              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "storey number or name, when known",
          "title": "Storey"
        }
      },
      "required": [
        "id",
        "page",
        "box"
      ],
      "title": "Plan",
      "type": "object"
    },
    "ReaderView": {
      "additionalProperties": false,
      "description": "What one double-check reader saw on the sheet. Never scored, never counted.",
      "properties": {
        "read": {
          "description": "the element classes it looked for",
          "items": {
            "enum": [
              "door",
              "window",
              "toilet",
              "sink",
              "shower",
              "bathtub",
              "sauna_stove",
              "stair",
              "wall",
              "column",
              "beam",
              "slab",
              "railing",
              "furniture"
            ],
            "type": "string"
