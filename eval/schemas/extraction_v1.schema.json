        },
        "elements": {
          "items": {
            "$ref": "#/$defs/Element"
          },
          "title": "Elements",
          "type": "array"
        }
      },
      "required": [
        "read"
      ],
      "title": "ReaderView",
      "type": "object"
    },
    "Resolution": {
