    "Scale": {
      "additionalProperties": false,
      "description": "The sheet's scale and every kind of scale evidence it shows (Bogdan, 2026-11-13 22:31), and\non every image a value to get areas from, approximated where nothing is printed (Bogdan, 23:33:\n\"We should have ON ALL IMAGES THE SCALE TO GET THE AREA, BY APROXIMATING IT IN DIFFERENT WAYS\nIF NOT GOOD SCALE ETC.\").",
      "properties": {
        "status": {
          "description": "scaled (measured, two checks); estimated (approximated without usable printed evidence); not_to_scale (the sheet says so; may still carry an approximate value); no_scale (no method applies)",
          "enum": [
            "scaled",
            "no_scale",
            "not_to_scale",
            "estimated"
          ],
          "title": "Status",
          "type": "string"
        },
        "m_per_unit": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "metres per page unit (px or pt): scaled and estimated; optional on not_to_scale",
          "title": "M Per Unit"
        },
        "evidence": {
          "description": "every kind visible on the sheet",
          "items": {
            "enum": [
              "scale_text",
              "scale_bar",
              "printed_areas",
              "dimension_lines",
              "not_to_scale_note"
            ],
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "the printed scale, e.g. 1:100",
          "title": "Text"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "how the value was derived, in words",
          "title": "Source"
        },
        "uncertainty": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "relative, e.g. 0.08: estimated and a valued not_to_scale",
          "title": "Uncertainty"
        },
        "reference_m_per_unit": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "a reference unit (e.g. the annotation's), not truth",
          "title": "Reference M Per Unit"
        }
      },
      "required": [
        "status"
      ],
      "title": "Scale",
      "type": "object"
    },
    "Subject": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "room",
            "apartment",
            "class",
            "sheet"
          ],
          "title": "Kind",
          "type": "string"
        },
        "ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "a room or apartment id in this file, an element class, or null for sheet",
          "title": "Ref"
        }
      },
      "required": [
        "kind",
        "ref"
      ],
      "title": "Subject",
      "type": "object"
    },
    "Table": {
      "additionalProperties": false,
      "description": "A schedule printed on the sheet (door, window, hardware, finish, room schedules).",
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "page": {
          "minimum": 1,
          "title": "Page",
