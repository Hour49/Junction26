          "title": "Page"
        },
        "box": {
          "anyOf": [
            {
              "description": "[x0, y0, x1, y1] as page fractions, origin top left",
              "maxItems": 4,
              "minItems": 4,
              "prefixItems": [
                {
                  "maximum": 1.0,
                  "minimum": 0.0,
                  "type": "number"
                },
                {
                  "maximum": 1.0,
                  "minimum": 0.0,
                  "type": "number"
                },
                {
                  "maximum": 1.0,
                  "minimum": 0.0,
                  "type": "number"
                },
                {
                  "maximum": 1.0,
                  "minimum": 0.0,
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Box"
        }
      },
      "required": [
        "value",
        "method"
      ],
      "title": "MeasuredValue",
      "type": "object"
