{
  "$defs": {
    "Apartment": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "area_m2": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Area M2"
        }
      },
      "required": [
        "id"
      ],
      "title": "Apartment",
      "type": "object"
    },
    "ArbiterReading": {
      "additionalProperties": false,
      "description": "What the local count arbiter read of one count family on the sheet. Never scored, never\ncounted.",
      "properties": {
        "probs": {
          "description": "the page-level count model L1's P(count = i), i = 0, 1, ...",
          "items": {
            "maximum": 1.0,
            "minimum": 0.0,
            "type": "number"
          },
          "minItems": 1,
          "title": "Probs",
          "type": "array"
        },
        "p": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "the arbiter's P that the count it kept or set is right; null: it sets no count of this family",
          "title": "P"
        }
      },
      "required": [
        "probs"
      ],
      "title": "ArbiterReading",
      "type": "object"
    },
    "Conflict": {
      "additionalProperties": false,
      "description": "One quantity two independent methods measured on this file (ingestion stage 8).",
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "quantity": {
          "enum": [
            "room_area",
            "apartment_area",
            "floor_area",
            "room_count",
            "element_count",
            "scale",
            "storey_count",
            "other"
          ],
          "title": "Quantity",
          "type": "string"
        },
        "subject": {
          "$ref": "#/$defs/Subject"
        },
        "status": {
          "enum": [
            "conflict",
            "agree"
          ],
          "title": "Status",
          "type": "string"
        },
        "tolerance": {
          "description": "relative; 0 for counts",
          "minimum": 0,
          "title": "Tolerance",
          "type": "number"
        },
        "values": {
          "items": {
            "$ref": "#/$defs/MeasuredValue"
          },
          "minItems": 2,
          "title": "Values",
          "type": "array"
        },
        "resolution": {
          "anyOf": [
            {
              "$ref": "#/$defs/Resolution"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "the value to report and the rule; null when no rule decides"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "id",
        "quantity",
        "subject",
        "status",
        "tolerance",
        "values"
      ],
      "title": "Conflict",
      "type": "object"
    },
    "Element": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
