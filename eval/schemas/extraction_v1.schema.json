  "additionalProperties": false,
  "description": "One drawing file: its pages, plans, elements, rooms, apartments and, optionally, its\nschedules, stage-8 conflicts and the objects of its BIM model (extraction_v1).",
  "properties": {
    "schema": {
      "const": "extraction_v1",
      "title": "Schema",
      "type": "string"
    },
    "file": {
      "description": "the path as in questions.jsonl",
      "pattern": "^data/[^/]+/.+",
      "title": "File",
      "type": "string"
    },
    "split": {
      "enum": [
        "dev",
        "eval"
      ],
      "title": "Split",
      "type": "string"
    },
    "truth": {
      "description": "elements: full element and room lists; counts: only `counts` is scored; tables: a schedule sheet, only `tables` is scored",
      "enum": [
        "elements",
        "counts",
        "tables"
      ],
      "title": "Truth",
      "type": "string"
    },
    "pages": {
      "description": "at least one, except on an .ifc file read as a model: there [] with model_objects, and empty plans, elements and rooms",
      "items": {
        "$ref": "#/$defs/Page"
      },
      "title": "Pages",
      "type": "array"
    },
    "scale": {
      "$ref": "#/$defs/Scale"
    },
    "plans": {
      "items": {
        "$ref": "#/$defs/Plan"
      },
      "title": "Plans",
      "type": "array"
    },
    "elements": {
      "items": {
        "$ref": "#/$defs/Element"
      },
      "title": "Elements",
      "type": "array"
    },
    "rooms": {
      "items": {
        "$ref": "#/$defs/Room"
      },
      "title": "Rooms",
      "type": "array"
    },
    "apartments": {
      "items": {
        "$ref": "#/$defs/Apartment"
      },
      "title": "Apartments",
      "type": "array"
    },
    "counts": {
      "anyOf": [
        {
          "additionalProperties": {
            "minimum": 0,
            "type": "integer"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "keys: an element class, room:<type>, or plan",
      "title": "Counts"
    },
    "tables": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/Table"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "schedules a question can ask",
      "title": "Tables"
    },
    "conflicts": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/Conflict"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "quantities measured by two methods, agreeing or not",
      "title": "Conflicts"
    },
    "read": {
      "anyOf": [
        {
          "items": {
            "anyOf": [
              {
                "enum": [
                  "door",
                  "window",
                  "toilet",
                  "sink",
                  "shower",
                  "bathtub",
                  "sauna_stove",
                  "stair",
                  "wall",
                  "column",
                  "beam",
                  "slab",
                  "railing",
                  "furniture"
                ],
                "type": "string"
              },
              {
                "const": "room",
                "type": "string"
              }
            ]
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "the element classes, and room, this extraction looked for; null: everything its truth covers. A class left out was not read: its count is unknown, not 0",
      "title": "Read"
    },
    "model_objects": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/ModelObject"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "every object of the BIM model the file comes from, all storeys, drawn here or not; null: the source has no model",
      "title": "Model Objects"
    },
    "double_check": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/ReaderView"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "what other readers saw on the sheet, by reader name, for marking where they disagree with a count; never scored; null: none ran",
      "title": "Double Check"
    },
    "count_arbiter": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/ArbiterReading"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "what the local count arbiter read, by count family (door, room:wc, sauna_stove...), for the answer's local gate; never scored; null: it did not run",
      "title": "Count Arbiter"
    },
    "notes": {
      "items": {
        "type": "string"
      },
      "title": "Notes",
      "type": "array"
    }
  },
  "required": [
    "schema",
    "file",
    "split",
    "truth",
    "pages",
    "scale",
    "plans",
    "elements",
    "rooms"
  ],
  "title": "Extraction_v1",
  "type": "object"
}
