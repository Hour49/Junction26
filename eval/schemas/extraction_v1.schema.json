    "ModelObject": {
      "additionalProperties": false,
      "description": "One object of the BIM model the sheet comes from, drawn on this sheet or not (formats v1.2,\n2026-11-14): storey sums and counts \"in the model\" need every object.",
      "properties": {
        "id": {
          "description": "unique in the file, not an element or room id",
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "class": {
          "anyOf": [
            {
              "enum": [
                "door",
                "window",
                "toilet",
                "sink",
                "shower",
                "bathtub",
                "sauna_stove",
                "stair",
                "wall",
                "column",
                "beam",
                "slab",
                "railing",
                "furniture"
              ],
              "type": "string"
            },
            {
              "const": "space",
              "type": "string"
            }
          ],
          "title": "Class"
        },
        "storey": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "IfcBuildingStorey.Name, as the model has it",
          "title": "Storey"
        },
        "global_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Global Id"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "the object's Name, raw",
          "title": "Name"
        },
        "long_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "an IfcSpace LongName, raw",
          "title": "Long Name"
        },
        "quantities": {
          "additionalProperties": {
            "minimum": 0,
            "type": "number"
          },
          "description": "area_m2 on a space: net floor area as the dataset defines it; side_area_m2: one face of a wall",
          "propertyNames": {
            "enum": [
              "length_m",
              "height_m",
              "width_m",
              "area_m2",
              "side_area_m2",
              "volume_m3"
            ]
          },
          "title": "Quantities",
          "type": "object"
        },
        "element": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "the drawn element on this sheet (a room, for a space); null: not drawn here",
          "title": "Element"
        },
        "attrs": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Attrs",
          "type": "object"
        }
      },
      "required": [
        "id",
        "class"
      ],
      "title": "ModelObject",
      "type": "object"
    },
    "Page": {
