// junction.hour49.com: the HTML demo (src/index.js adds the Credits strip to its pages), served from the static
// assets that build-assets.sh puts into ./assets (gitignored). Deploy from this folder: set CLOUDFLARE_ACCOUNT_ID and
// CLOUDFLARE_API_TOKEN in the env, run ./build-assets.sh, then `npx wrangler@4.161.0 deploy`. No secrets.
// No account id here: the repo is public. `--env preview` deploys a copy to workers.dev, no custom domain.
{
  "name": "hour49-junction",
  "main": "src/index.js",
  "compatibility_date": "2026-11-10",
  "assets": { "directory": "./assets", "binding": "ASSETS", "run_worker_first": true },
  "routes": [{ "pattern": "junction.hour49.com", "custom_domain": true }],
  "env": {
    "preview": {
      "name": "hour49-junction-preview",
      "workers_dev": true,
      "routes": [],
      "assets": { "directory": "./assets", "binding": "ASSETS", "run_worker_first": true }
    }
  }
}
